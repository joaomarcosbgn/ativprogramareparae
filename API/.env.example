# Copie para .env e configure as variáveis no ambiente do servidor.
# O arquivo .env não é carregado automaticamente pelo FastAPI.
REPARAE_ENV=development
REPARAE_SECRET_KEY=COLOQUE_AQUI_UMA_CHAVE_ALEATORIA_FORTE_E_PERMANENTE
# Opcional: Chatbase Identity Verification, conforme chave fornecida pelo Chatbase
CHATBASE_IDENTITY_SECRET=

# Pagamento Pix — Mercado Pago (somente no back-end; nunca no front-end)
# Comece com credenciais de TESTE (painel Mercado Pago > Suas integrações > Credenciais de teste)
MERCADOPAGO_ACCESS_TOKEN=
# "Assinatura secreta" gerada ao configurar o webhook (evento: Pagamentos)
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública do webhook (padrão: https://reparae-api.onrender.com/webhooks/mercadopago)
MERCADOPAGO_NOTIFICATION_URL=
# Validade do QR Code em minutos (padrão 30)
PIX_EXPIRACAO_MINUTOS=30
