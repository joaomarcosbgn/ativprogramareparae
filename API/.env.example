# Copie para .env e configure as variáveis no ambiente do servidor.
# O arquivo .env não é carregado automaticamente pelo FastAPI.
REPARAE_ENV=development
REPARAE_SECRET_KEY=COLOQUE_AQUI_UMA_CHAVE_ALEATORIA_FORTE_E_PERMANENTE
# Opcional: Chatbase Identity Verification, conforme chave fornecida pelo Chatbase
CHATBASE_IDENTITY_SECRET=
